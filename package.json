{
  "name": "life-book",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm --filter @life-book/server dev\" \"pnpm --filter @life-book/web dev\"",
    "dev:mobile": "pnpm --filter @life-book/mobile start",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @life-book/server db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
