{
  "name": "@life-book/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/scripts/migrate.ts && tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "serve": "sh scripts/serve.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "create-user": "tsx src/scripts/create-user.ts",
    "reset-password": "tsx src/scripts/reset-password.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@life-book/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
