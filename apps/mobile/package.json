{
  "name": "@life-book/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo prebuild --platform android --clean --no-install && expo run:android",
    "android:release": "sh scripts/android-release.sh",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --no-install",
    "dependencies:check": "expo install --check",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@life-book/api-client": "workspace:*",
    "@life-book/core": "workspace:*",
    "@life-book/design-tokens": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "5.104.4",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-query-persist-client": "5.104.4",
    "expo": "57.0.30",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.22",
    "expo-crypto": "57.0.4",
    "expo-dev-client": "57.0.20",
    "expo-linking": "57.0.13",
    "expo-notifications": "57.0.23",
    "expo-router": "57.0.28",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1"
